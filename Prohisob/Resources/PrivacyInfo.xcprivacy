<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Maxfiylik manifesti: kuzatuv (tracking) yo'q, reklama yo'q, analitika yo'q. Ilova faqat foydalanuvchi o'zi kiritgan hisob
     ma'lumotini (yozuvlar, summalar, chek rasmlari, ism/telefon) Prohisob serveriga — ilova ishlashi uchun — yuboradi.
     UserDefaults — faqat ilovaning o'z sozlamalari (mavzu, Face ID, tanlangan kabinet): CA92.1. -->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
